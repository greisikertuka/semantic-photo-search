# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Managed Python interpreters (installed outside the repo, but ignore if nested)
.uvpython/

# Data: TSV, parquet, embeddings, Chroma, thumbnails. Never commit (licensing) — see PLAN.md / README.
# Rebuilt via the indexing pipeline or downloaded as a GitHub Release asset (Session 12).
/data/*
!/data/.gitkeep

# Local photo library index (Session 9) and model caches
/space/*.npy
/space/*.parquet

# Session 11b: the deploy payload (index + ONNX encoder, ~210 MB) is built by
# scripts/06 and scripts/07 and published as a GitHub Release asset, never committed.
# `dist/` is already ignored above as a Python build dir, which is where the tarballs go.
/data/encoder/

# Eval: the judgments and the pool ARE committed (they're the gold set — photo ids
# and labels, no pixels). The downloaded thumbnails and rendered contact sheets are
# images, so they follow the same never-redistribute rule as data/.
/eval/cache/
/eval/sheets/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/

# Windows crash dumps
*.stackdump
